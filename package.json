{
  "name": "pippo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-sharing": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test:backup && npm run test:selection && npm run test:study-time && npm run test:character-state",
    "test:backup": "node --experimental-strip-types --import ./tests/register.mjs ./tests/backup.test.mjs",
    "test:selection": "node --experimental-strip-types --import ./tests/register.mjs ./tests/selection.test.mjs",
    "test:study-time": "node --experimental-strip-types --import ./tests/register.mjs ./tests/studyTime.test.mjs",
    "test:character-state": "node --experimental-strip-types --import ./tests/register.mjs ./tests/characterState.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
